# Pinned versions verified against llm-d-gke-cpu-lab and upstream releases
export NAMESPACE="llm-d-observatory"
export RELEASE_NAME="llm-d-router"
export DEPLOYMENT_PROFILE="experimental-small"

# Gateway API & Gateway API Inference Extension (GAIE)
export GATEWAY_API_VERSION="v1.6.2"
export GAIE_VERSION="v1.6.2"
export GAIE_CRD_URL="https://github.com/kubernetes-sigs/gateway-api-inference-extension/releases/download/v1.6.2/v1-manifests.yaml"

# llm-d Router & Endpoint Picker (EPP)
export ROUTER_RELEASE_VERSION="v1.0.0"
export ROUTER_CHART_VERSION="v1.0.0"
export ROUTER_CRD_URL="https://github.com/llm-d/llm-d-router/releases/download/v1.0.0/manifests.yaml"
export ROUTER_STANDALONE_CHART="oci://ghcr.io/llm-d/charts/llm-d-router-standalone"
export ROUTER_EPP_IMAGE="ghcr.io/llm-d/llm-d-router-endpoint-picker:v1.0.0"
export ENVOY_PROXY_IMAGE="docker.io/envoyproxy/envoy:distroless-v1.33.2"

# vLLM CPU Model Server
export VLLM_CPU_IMAGE="docker.io/vllm/vllm-openai-cpu:v0.31.0"
export MODEL="Qwen/Qwen2.5-0.5B-Instruct"

# OpenTelemetry, Jaeger & Prometheus
export OTEL_COLLECTOR_IMAGE="otel/opentelemetry-collector-contrib:0.114.0"
export JAEGER_IMAGE="jaegertracing/all-in-one:1.62.0"
export PROMETHEUS_IMAGE="prom/prometheus:v2.55.1"
